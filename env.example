# =============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# =============================================================================
# SUPABASE - Required
# Get these from your Supabase project: Settings > API
# =============================================================================

# Your Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key (SERVER ONLY - NEVER expose to client)
# This key bypasses Row Level Security - use with caution
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# SITE CONFIGURATION - Required for OAuth redirects
# =============================================================================

# Your site URL (for OAuth callback redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# AI SERVICES - Required for AI features
# =============================================================================

# Groq API Key - Get from https://console.groq.com/
# Used for LLM chat completions
GROQ_API_KEY=gsk_...

# Perplexity API Key - Get from https://www.perplexity.ai/
# Used for deep research agent
PERPLEXITY_API_KEY=pplx-...

# BytePlus API Key - Used for image generation
BYTEPLUS_API_KEY=your_byteplus_key_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit real API keys or secrets to version control
# 2. Use different keys for development vs production
# 3. Rotate keys if they are ever exposed
# 4. SUPABASE_SERVICE_ROLE_KEY should ONLY be used in server-side code
# 5. Variables starting with NEXT_PUBLIC_ are exposed to the browser
#
# =============================================================================
